# Copy to .env and fill in real values.
# `.env` is gitignored.

# === Redis (queue + result store) ===
REDIS_URL=redis://localhost:6379/0

# === Where job outputs (PDFs, DOCX) are written ===
STORAGE_DIR=./storage

# === CORS: the Next.js frontend origin ===
FRONTEND_ORIGIN=http://localhost:3000

# === AI service keys (used by the client's processing script) ===
# Leave blank to run with the stub job that returns fake data.
TWELVELABS_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
